# Audio
ro.audio.silent=0
ro.audio.flinger_standbytime_ms=1000
ro.audio.usb.period_us=16000
ro.camera.sound.forced=0

# Camera
ro.camera.notify_nfc=1

# Display
sys.brightness.disable_gamma_conversion=true

# Radio
ro.vendor.mtk_gwsd_support=1
ro.vendor.mtk_telephony_add_on_policy=0
ro.vendor.vodata_support=1
persist.vendor.mtk_rcs_single_reg_support=1
persist.vendor.mtk.vilte.enable=1
persist.vendor.pco5.radio.ctrl=0
vendor.rild.libargs=-d /dev/ttyC0
vendor.rild.libpath=mtk-ril.so

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true

# NFC
persist.nfc_vendor_extn.lib_file_name=libnfc_vendor_extn_st.so

# NTF
ro.build.nothing.feature.base=0x800001004458438124a040106b4247b97ffL
ro.build.nothing.feature.diff.device.Pacman=0x240304400040128d3493f4d00250c42080L
ro.build.nothing.feature.diff.device.PacmanPro=0x40304400040128db493f4d00250c42080L
ro.build.nothing.feature.diff.product.PacmanEEA=0x8000000000000000000000L
ro.build.nothing.feature.diff.product.PacmanIND=0x10000000000000000000000L
ro.build.nothing.feature.diff.product.PacmanJPN=0x20000000000000000000000L
ro.build.nothing.feature.diff.product.PacmanProEEA=0x8000000000000000000000L
ro.build.nothing.feature.diff.product.PacmanProIND=0x10000000000000000000000L

# Wifi
wifi.direct.interface=p2p0
wifi.interface=wlan0
wifi.tethering.interface=ap0

#Mist Os
ro.mist.display=1084x2412 120 hz
ro.mist.battery=5000 mAh
ro.mist.soc=Mediatek Dimensity 7200 pro
ro.mist.camera=50MP + 50MP
ro.mist.front=32MP
ro.mist.platform=MT6886
ro.mist.screen=6.7" Flexible Amoled
ro.mist.device.name=Nothing Phone 2a
